# ─── Application ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/logiquest
JWT_SECRET=your_jwt_secret
JWT_EXPIRY=1h
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://logiquest.app

# ─── Redis (BullMQ job queue) ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password   # optional – uncomment if auth is enabled

# ─── Email ────────────────────────────────────────────────────────────────────
# Choose "smtp" or "sendgrid"
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@logiquest.app

# SMTP settings (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# SendGrid API key (used when EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
